+uint32_t Net_Slirp::TakePollErrorCount() noexcept
+{
+    return PollErrorCount.exchange(0, std::memory_order_relaxed);
+}
+
+int Net_Slirp::LastPollError() const noexcept
+{
+    return LastPollErrorCode.load(std::memory_order_relaxed);
+}
